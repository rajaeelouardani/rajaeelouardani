# Gmail SMTP — formulaire de contact
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Guide : https://myaccount.google.com/apppasswords

GMAIL_USER=elouardanirajae@gmail.com
GMAIL_APP_PASSWORD=votre_mot_de_passe_application_16_caracteres

# Optionnel : adresse qui reçoit les messages (par défaut = GMAIL_USER)
CONTACT_RECIPIENT=elouardanirajae@gmail.com
